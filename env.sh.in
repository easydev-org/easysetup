# /opt/setup/env.sh — put every installed toolchain on PATH.
#
# A CI job does ONE thing to get all of its runtimes:
#
#     . /opt/setup/env.sh
#
# Each tool is unpacked under /opt/setup/<tool> and never touches /usr, so the
# base image stays clean and two toolchains cannot fight over a path.
#
# @TOOLS@ is replaced at build time with the tools in this image, so this file
# only ever exports directories that actually exist.

for _d in @TOOLS@; do
  [ -d "/opt/setup/$_d/bin" ] && PATH="/opt/setup/$_d/bin:$PATH"
done

# java needs JAVA_HOME for most build tools (maven, gradle, sbt).
if [ -d /opt/setup/java ]; then
  JAVA_HOME=/opt/setup/java
  export JAVA_HOME
fi

export PATH
unset _d
